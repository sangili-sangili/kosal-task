{
  "name": "enterprise-backend",
  "version": "1.0.0",
  "description": "Production-ready enterprise Node.js Express backend with MVC, Clean Architecture, Sequelize, Redis, and BullMQ",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "db:migrate": "npx sequelize-cli db:migrate --config database/config.js --migrations-path database/migrations",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo --config database/config.js --migrations-path database/migrations",
    "db:seed": "npx sequelize-cli db:seed:all --config database/config.js --seeders-path database/seeders",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all --config database/config.js --seeders-path database/seeders"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.6",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "rate-limit-redis": "^4.2.0",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Enterprise Architecture Team",
  "license": "ISC"
}
