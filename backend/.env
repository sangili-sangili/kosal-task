NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database configuration (MySQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=real_estate_crm
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_DIALECT=mysql
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_POOL_IDLE=10000
DATABASE_POOL_ACQUIRE=30000

# Set to false to use active local MySQL instance
USE_SQLITE_FALLBACK=false

# Legacy aliases for compatibility
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=real_estate_crm
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# JWT Secrets
JWT_ACCESS_SECRET=enterprise_jwt_access_secret_production_key_32bytes_minimum!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=enterprise_jwt_refresh_secret_production_key_32bytes_minimum!
JWT_REFRESH_EXPIRES_IN=7d

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# Logging
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
