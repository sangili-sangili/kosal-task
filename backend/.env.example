NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enterprise_db
DB_USER=root
DB_PASSWORD=root_password
DB_DIALECT=mysql
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# SQLite fallback for quick zero-setup testing if MySQL is not running
USE_SQLITE_FALLBACK=true

# JWT Secrets
JWT_ACCESS_SECRET=enterprise_jwt_access_secret_production_key_32bytes_minimum!
JWT_REFRESH_SECRET=enterprise_jwt_refresh_secret_production_key_32bytes_minimum!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
