# ==========================================
# Real Estate CRM - Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MySQL / PostgreSQL / SQLite)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=real_estate_crm
DATABASE_USER=root
DATABASE_PASSWORD=root_password
DATABASE_DIALECT=mysql

# Database Connection Pool
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_POOL_IDLE=10000
DATABASE_POOL_ACQUIRE=30000

# Zero-setup local SQLite fallback flag (set to false in production MySQL environment)
USE_SQLITE_FALLBACK=true

# Authentication Security (JWT)
JWT_ACCESS_SECRET=enterprise_jwt_access_secret_production_key_32bytes_minimum!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=enterprise_jwt_refresh_secret_production_key_32bytes_minimum!
JWT_REFRESH_EXPIRES_IN=7d

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
