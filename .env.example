# ==============================================
# Enterprise Full-Stack Application Environment Configuration
# ==============================================

# Node Environment
NODE_ENV=development
PORT=5000

# Backend Base URLs
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enterprise_db
DB_USER=root
DB_PASSWORD=root_password
DB_DIALECT=mysql
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# JWT Security
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_min_32_chars!
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_min_32_chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Redis Configuration (Cache & Queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_FILE_ENABLED=true

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE=Enterprise SaaS Platform
